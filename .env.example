# Copy this file to .env locally. Do not commit real keys.

# OpenAI-compatible hosted LLM endpoint.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-provider-compatible-endpoint/v1
LLM_MODEL=your-model-name

# Optional OpenAI default variable used by the generation wrapper.
OPENAI_API_KEY=your_api_key_here

# Optional generation settings.
LLM_MAX_TOKENS=64
